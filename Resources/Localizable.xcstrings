    "Covers every screen with black, so you can wipe it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Covers every screen with black, so you can wipe it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deckt jeden Bildschirm schwarz ab, damit du ihn abwischen kannst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cubre cada pantalla de negro, para que puedas limpiarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Couvre chaque écran de noir, pour que vous puissiez l'essuyer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copre ogni schermo di nero, così puoi pulirlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cobre cada tela de preto, para que você possa limpá-la."
          }
        }
      }
    },
