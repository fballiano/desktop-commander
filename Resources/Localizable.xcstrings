    "accessibility.alert.message": {
      "comment": "The message of the alert that asks for the Accessibility permission.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every window command needs it, and so does the keyboard lock. Nothing else does.\n\nOpen System Settings, then Privacy & Security, then Accessibility, and switch desktop-commander on."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Fensterbefehl benötigt sie, und die Tastatursperre auch. Sonst nichts.\n\nÖffne die Systemeinstellungen, dann „Datenschutz & Sicherheit“, dann „Bedienungshilfen“, und schalte desktop-commander ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada comando de ventana lo necesita, y el bloqueo del teclado también. Nada más.\n\nAbre Ajustes del Sistema, luego Privacidad y seguridad, luego Accesibilidad, y activa desktop-commander."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque commande de fenêtre en a besoin, et le verrouillage du clavier aussi. Rien d'autre.\n\nOuvrez Réglages Système, puis Confidentialité et sécurité, puis Accessibilité, et activez desktop-commander."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni comando delle finestre ne ha bisogno, e anche il blocco della tastiera. Nient'altro.\n\nApri Impostazioni di Sistema, poi Privacy e sicurezza, poi Accessibilità, e attiva desktop-commander."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada comando de janela precisa dela, e o bloqueio do teclado também. Nada mais.\n\nAbra os Ajustes do Sistema, depois Privacidade e Segurança, depois Acessibilidade, e ative o desktop-commander."
          }
        }
      }
    },
    "desktop-commander Preferences": {
